{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin": "4 6 0 6",
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 42,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "{:%A, %d de %B de %Y}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Mudo",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
